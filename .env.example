# Opcional. Por defecto el tutor es local y gratis (Ollama + gemma3:4b) y no necesitas este fichero.
# TUTOR_LLM=auto
# TUTOR_OLLAMA_MODEL=gemma3:4b      # alternativa más ligera: qwen3.5:4b

# API de Claude (de pago, independiente de la suscripción de Claude). Sólo si quieres más calidad:
# TUTOR_LLM=anthropic
# ANTHROPIC_API_KEY=

# Modelos de Claude (por defecto Claude Opus 5.5 con esfuerzo bajo para la conversación: mejor latencia).
# TUTOR_CHAT_MODEL=claude-opus-5-5
# TUTOR_CHAT_EFFORT=low
# TUTOR_EVAL_MODEL=claude-opus-5-5
# TUTOR_EVAL_EFFORT=low

# Voz del tutor (Kokoro): af_heart, af_bella, am_michael, bf_emma, bm_george… · voz para el español: ef_dora / em_alex
# TUTOR_VOICE_EN=af_heart
# TUTOR_TTS_SPEED=0.95

# TUTOR_LESSON_SECONDS=900
# TUTOR_PORT=8765
